---
import { ArrowRight, BadgeCheck, Check, Clock3, Flame, Phone, ShieldCheck, Thermometer, Wrench } from '@lucide/astro'
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import BlogCard from '@/components/BlogCard.astro'
import ProjectForm from '@/components/ProjectForm.astro'
import ServiceCard from '@/components/ServiceCard.astro'
import ServiceCarousel from '@/components/ServiceCarousel.astro'
import WhyChooseUs from '@/components/WhyChooseUs.astro'
import { defaultServices, phoneHref, siteSettings, whatsappHref } from '@/data/site'
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/ui/accordion'
import SiteImage from '@/components/SiteImage.astro'

const siteUrl = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '')

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': siteSettings.brandName,
      'description': siteSettings.heroDescription,
      'publisher': {
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'HomeAndConstructionBusiness',
      '@id': `${siteUrl}/#organization`,
      'name': siteSettings.brandName,
      'url': siteUrl,
      'logo': `${siteUrl}/favicon.svg`,
      'image': `${siteUrl}/og-image.webp`,
      'telephone': siteSettings.phone,
      'email': siteSettings.email,
      'priceRange': '₺₺',
      'areaServed': 'TR',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Merkez İş Merkezi No: 12',
        'addressLocality': siteSettings.location,
        'addressRegion': siteSettings.location,
        'addressCountry': 'TR',
      },
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          'opens': '08:00',
          'closes': '20:00',
        },
      ],
      'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Kombi Bakım, Arıza ve Isıtma Sistemi Hizmetleri',
        'itemListElement': defaultServices.map((service) => ({
          '@type': 'Offer',
          'itemOffered': {
            '@type': 'Service',
            'name': service.shortTitle,
            'url': `${siteUrl}/${service.slug}`,
            'description': service.summary,
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Kombi bakımı ne kadar sürer?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Standart bir kombi bakımı ortalama 40-60 dakika sürer. Yanma odası, eşanjör, filtre, genleşme tankı ve emniyet donanımları dahil 21 nokta kontrol edilir; gerekli görülen parçalar için onayınız alınır.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Petek temizliği gerekli mi, nasıl yapılıyor?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Peteklerin üstü sıcak altı soğuksa veya doğalgaz faturası yükseldiyse sistemde çamur ve kireç birikmiştir. Makine destekli kimyasal dolaşım ve durulama ile tesisat temizlenir, ısı verimi geri kazanılır.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Aynı gün servis geliyor mu?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Sabah 08:00-12:00 arasında gelen taleplerde aynı gün içinde, yoğunluğa göre en geç ertesi gün servise çıkıyoruz. Acil arızalarda (gaz kokusu, su kaçığı, ateşleme hatası) öncelikli randevu açıyoruz.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Kullandığınız yedek parçalar orijinal mi?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Anakart, pompa, fan, brülör ve eşanjör değişimlerinde orijinal veya üretici onaylı eşdeğer parça kullanıyoruz. Değişen her parça faturalıdır ve işçilikle birlikte 1 yıl firmamız garantisi altındadır.',
          },
        },
      ],
    },
  ],
}

const orderedServices = [...defaultServices].sort((a, b) => {
  if (Boolean(a.featured) !== Boolean(b.featured)) {
    return a.featured ? -1 : 1
  }
  return a.order - b.order
})

const posts = (await getCollection('posts')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())

const highlights = [
  ['AYNI', 'GÜN SERVİS'],
  ['7/24', 'WHATSAPP DESTEK'],
  ['1 YIL', 'İŞÇİLİK GARANTİSİ'],
  ['ŞEFFAF', 'FİYAT TEKLİFİ'],
  ['ORİJİNAL', 'YEDEK PARÇA'],
  ['TÜM', 'MARKA DESTEK'],
]

const processSteps = [
  ['01', 'Kayıt ve Ön Bilgi', 'Telefon veya WhatsApp üzerinden arıza belirtilerini ve kombi marka/model bilgisini alıyoruz, olası nedeni önden paylaşıyoruz.'],
  ['02', 'Yerinde Arıza Tespiti', 'Teknik ekibimiz cihazı, tesisatı ve baca grubunu ölçüm cihazıyla kontrol eder; sorunu tahminle değil veriyle belirler.'],
  ['03', 'Net Fiyat Onayı', 'İşçilik ve parça maliyeti işlem başlamadan yazılı olarak paylaşılır. Onay vermeden hiçbir parça değiştirilmez.'],
  ['04', 'Onarım ve Temizlik', 'Onarım, bakım veya temizlik yapılır; yanma ayarı, su basıncı ve güvenlik emniyetleri yeniden kalibre edilir.'],
  ['05', 'Test ve Garanti Belgesi', 'Cihaz tam kapasitede çalıştırılıp size teslim edilir. İşlem garanti belgesi ve faturayla kayıt altına alınır.'],
]

const faqs = [
  ['Kombi bakımı ne kadar sürer?', 'Standart bir kombi bakımı ortalama 40-60 dakika sürer. Yanma odası, eşanjör, filtre, genleşme tankı ve emniyet donanımları dahil 21 nokta kontrol edilir; gerekli görülen parçalar için onayınız alınır.'],
  ['Petek temizliği gerekli mi, nasıl yapılıyor?', 'Peteklerin üstü sıcak altı soğuksa veya doğalgaz faturası yükseldiyse sistemde çamur ve kireç birikmiştir. Makine destekli kimyasal dolaşım ve durulama ile tesisat temizlenir, ısı verimi geri kazanılır.'],
  ['Aynı gün servis geliyor mu?', 'Sabah 08:00-12:00 arasında gelen taleplerde aynı gün içinde, yoğunluğa göre en geç ertesi gün servise çıkıyoruz. Acil arızalarda öncelikli randevu açıyoruz.'],
  ['Kullandığınız yedek parçalar orijinal mi?', 'Anakart, pompa, fan, brülör ve eşanjör değişimlerinde orijinal veya üretici onaylı eşdeğer parça kullanıyoruz. Değişen her parça faturalıdır ve işçilikle birlikte 1 yıl firmamız garantisi altındadır.'],
  ['Kombi bakımı doğalgaz faturasını gerçekten düşürür mü?', 'Bakımsız bir kombide verim kaybı %15-25 seviyesine çıkabilir. Temiz yanma odası, doğru hava-gaz oranı ve dengeli tesisat ile aynı konforu daha az tüketimle alırsınız.'],
  ['Hangi markalara servis veriyorsunuz?', 'Vaillant, Bosch, Buderus, Demirdöküm, Viessmann, Airfel, Alarko, Baymak, ECA, Ferroli, Ariston, Warmhaus, Beko ve Grundfos dahil yoğuşmalı/yoğuşmasız tüm kombi markalarına servis veriyoruz.'],
]

const whyPoints = [
  { title: 'AYNI GÜN SERVİS AĞI', description: 'Şehir içi mobil ekiplerimiz sayesinde arıza bildiriminin ardından aynı gün kapınızdayız; kışı petek soğuk geçirmek zorunda kalmazsınız.' },
  { title: 'VERİYLE ARIZA TESPİTİ', description: 'Gaz kaçağı, basınç ve yanma ölçümlerini cihazla yapıyoruz. “Parça değiştirip görelim” yaklaşımına son; gereksiz masraf çıkmaz.' },
  { title: 'YAZILI NET FİYAT', description: 'İşlem başlamadan önce işçilik ve parça bedeli net olarak paylaşılır. İş bittikten sonra sürpriz ek ücret ile karşılaşmazsınız.' },
  { title: '1 YIL İŞÇİLİK GARANTİSİ', description: 'Yaptığımız bakım ve onarımın arkasında duruyoruz. Aynı arıza tekrarlanırsa ücretsiz tekrar hizmet veriyoruz.' },
]

const stats = [
  { target: 12, suffix: '+', label: 'YILLIK SAHA DENEYİMİ', description: 'Kombi ve ısıtma sistemlerinde uzman teknik kadro.' },
  { target: 8500, suffix: '+', label: 'TAMAMLANAN İŞLEM', description: 'Bakım, onarım ve petek temizliği kaydı.' },
  { target: 98, suffix: '%', label: 'İLK ZİYARETTE ÇÖZÜM', description: 'Arızaların büyük kısmı ilk ziyarette giderilir.' },
  { target: 24, suffix: '/7', label: 'WHATSAPP DESTEK', description: 'Randevu ve teknik yönlendirme her an ulaşılabilir.' },
]
---

<Layout
  title={`${siteSettings.brandName} | Kombi Bakım, Arıza ve Petek Temizliği Servisi`}
  description="Kombi bakımı, arıza tespit ve tamir, petek temizliği, kombi montajı ve doğalgaz tesisatı hizmetlerinde aynı gün servis ve net fiyat. Kombici Abi yanınızda."
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="home">
    <!-- Highlights -->
    <section class="highlight-strip" aria-label="Servis vaatlerimiz">
      <div class="shell">
        <ul class="highlight-list">
          {highlights.map(([mark, label]) => (
            <li class="highlight">
              <span class="highlight__mark"><span>{mark}</span></span>
              <span class="highlight__label">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Hero -->
    <section class="hero-home">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><Flame size={14} /> {siteSettings.heroEyebrow}</span>
          <h1>{siteSettings.heroTitle}</h1>
          <p class="hero-copy__title">Kombi bakım, arıza ve petek temizliğinde tahmine değil ölçüme dayanan servis.</p>
          <p class="hero-copy__description">{siteSettings.heroDescription}</p>
          <ul class="hero-checks">
            <li>Aynı gün randevu</li>
            <li>Yazılı net fiyat</li>
            <li>Orijinal yedek parça</li>
            <li>1 yıl işçilik garantisi</li>
          </ul>
          <div class="hero-actions">
            <a class="button button--primary" href="/iletisim#form">Servis Kaydı Oluştur <ArrowRight size={16} /></a>
            <a class="button button--outline" href={whatsappHref('Merhaba, kombi arızam için aynı gün servis istiyorum.')} target="_blank" rel="noreferrer">
              <Clock3 size={16} /> WhatsApp'tan Yazın
            </a>
          </div>
          <div class="rating-badge">
            <span class="rating-badge__g" aria-hidden="true">G</span>
            <span>
              <strong>4,9 <span aria-label="5 üzerinden 4,9">★★★★★</span></strong>
              <small>Müşteri değerlendirmesi · {siteSettings.location} geneli</small>
            </span>
          </div>
        </div>

        <div class="hero-visual">
          <span class="hero-visual__tag">MOBİL SERVİS</span>
          <div class="hero-visual__image">
            <SiteImage
              src="/images/home-process-technical-review.webp"
              alt="Kombi bakımını kontrol eden teknik servis ekibi"
              widths={[420, 640, 860]}
              sizes="(max-width: 1024px) 100vw, 420px"
              loading="eager"
              fetchpriority="high"
            />
            <div class="hero-visual__caption">
              <span>
                <small>21 nokta</small>
                <strong>Detaylı kombi bakımı</strong>
              </span>
              <span>40dk</span>
            </div>
          </div>
        </div>

        <aside class="process-preview" aria-label="Servis adımları">
          <div class="process-preview__head">
            <strong class="section-kicker">Nasıl çalışıyoruz?</strong>
            <small>Ortalama 2 saat</small>
          </div>
          <ol>
            <li><b>01</b><span><strong>Kayıt</strong><p>Marka, model ve arıza belirtileri alınır.</p></span></li>
            <li><b>02</b><span><strong>Yerinde tespit</strong><p>Ölçüm cihazıyla kesin neden bulunur.</p></span></li>
            <li><b>03</b><span><strong>Net fiyat</strong><p>Onayınız olmadan işlem yapılmaz.</p></span></li>
            <li><b>04</b><span><strong>Onarım</strong><p>Parça değişimi ve temizlik tamamlanır.</p></span></li>
            <li><b>05</b><span><strong>Test + garanti</strong><p>Fatura ve garanti belgesi teslim edilir.</p></span></li>
          </ol>
          <a class="process-preview__link" href="/hakkimizda">Servis yaklaşımımız <ArrowRight size={13} /></a>
        </aside>
      </div>
    </section>

    <!-- Services -->
    <ServiceCarousel />

    <section class="services-section bg-neutral-50" id="hizmetler">
      <div class="shell">
        <div class="section-top">
          <div>
            <h3 class="section-kicker">Tüm hizmetler</h3>
            <h2 class="section-heading">Kombi ve ısıtma sisteminizin tüm ihtiyaçları tek adreste.</h2>
          </div>
          <a href="/hizmetler">Tüm hizmetler <ArrowRight size={15} /></a>
        </div>
        <p class="section-lead">Bakımdan arıza onarımına, petek temizliğinden yeni kombi montajına kadar her işlem yazılı teklif, fatura ve garanti belgesiyle yürütülür.</p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {orderedServices.slice(0, 6).map((service, index) => <ServiceCard service={service} index={index + 1} />)}
        </div>
      </div>
    </section>

    <!-- Why us -->
    <WhyChooseUs points={whyPoints} stats={stats} heading="Isıtma sisteminizi neden Kombici Abi'ye emanet etmelisiniz?" />

    <!-- Process -->
    <section class="process-section" id="surec">
      <div class="shell">
        <h3 class="section-kicker">Servis akışı</h3>
        <h2 class="section-heading">Beş adımda şeffaf servis.</h2>
        <p class="section-lead">İşi karmaşıklaştırmıyoruz: kayıt, tespit, onay, işlem, teslim. Her adımda ne olduğunu ve ne ödeyeceğinizi baştan bilirsiniz.</p>
        <div class="process-grid">
          {processSteps.map(([number, title, text]) => (
            <article class="process-step">
              <span class="process-step__number">{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Blog -->
    <section class="blog-section">
      <div class="shell">
        <div class="section-top">
          <div>
            <h3 class="section-kicker">Bilgi merkezi</h3>
            <h2 class="section-heading">Kombinizi kışa hazırlayan rehberler.</h2>
          </div>
          <a href="/blog">Tüm yazılar <ArrowRight size={15} /></a>
        </div>
        <div class="blog-grid">
          {posts.slice(0, 3).map((post, index) => <BlogCard post={post} index={index + 1} />)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="process-section" id="sss">
      <div class="shell">
        <div class="section-top">
          <div>
            <h3 class="section-kicker">Sıkça sorulan sorular</h3>
            <h2 class="section-heading">Servis öncesi merak edilenler.</h2>
          </div>
          <a class="button button--primary" href={phoneHref}><Phone size={15} /> Hemen arayın</a>
        </div>
        <Accordion type="multiple" class="mt-8">
          {faqs.map(([question, answer], index) => (
            <AccordionItem value={`faq-${index + 1}`} open={index === 0}>
              <AccordionTrigger>{question}</AccordionTrigger>
              <AccordionContent>{answer}</AccordionContent>
            </AccordionItem>
          ))}
        </Accordion>
      </div>
    </section>

    <!-- Form -->
    <section class="form-section" id="servis-talebi">
      <div class="shell form-section__panel">
        <SiteImage class="form-section__image" src="/images/project-guidance.webp" alt="Kombi servisi öncesi tesisat kontrolü" />
        <div class="form-section__wash"></div>
        <ProjectForm services={defaultServices} hideHeading />
        <aside class="form-section__aside">
          <h3 class="eyebrow"><BadgeCheck size={14} /> Servis kaydı</h3>
          <h2>Formu doldurun, 10 dakika içinde arayalım.</h2>
          <p>Kombinizin marka ve modelini, yaşadığınız sorunu yazın; mümkün olan en yakın zaman için randevu planlayalım. Acil durumlarda telefon her zaman daha hızlıdır.</p>
          <div class="contact-points">
            <a class="contact-point" href={phoneHref}><span><Phone size={16} /></span>{siteSettings.phone}</a>
            <a class="contact-point" href={whatsappHref('Merhaba, kombi servisi için randevu almak istiyorum.')} target="_blank" rel="noreferrer"><span><Wrench size={16} /></span>WhatsApp ile yazın</a>
            <span class="contact-point"><span><Thermometer size={16} /></span>{siteSettings.workHours} · Pazar: Kapalı</span>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>
