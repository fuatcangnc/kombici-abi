---
import type { Service } from '@/data/site'
import { defaultServices, phoneHref, siteSettings, whatsappHref } from '@/data/site'
import { ArrowRight, BadgeCheck, CircleCheck, Clock3, FileCheck, Phone, ShieldCheck } from '@lucide/astro'
import ProjectForm from './ProjectForm.astro'
import SiteImage from './SiteImage.astro'

interface Props { service: Service }
const { service } = Astro.props

const related = defaultServices.filter((item) => item.category === service.category && item.slug !== service.slug).slice(0, 3)
const serviceFaqs = [
  [`${service.shortTitle} ne kadar sürer?`, 'Süre cihazın durumuna ve tesisatın uzunluğuna göre değişir; çoğu işlem aynı ziyaret içinde ortalama 1-2 saatte tamamlanır. Randevu öncesinde tahmini süre telefonda paylaşılır.'],
  ['İşlem öncesi hazırlık yapmalı mıyım?', 'Kombinin marka ve model bilgisi, varsa daha önce yapılan işlemlere ait fatura ve cihazın erişilebilir olması yeterlidir. Eşyalarınızın korunması için ekibimiz örtü ve temiz çalışma düzeniyle gelir.'],
  ['Fiyat nasıl belirleniyor?', 'Standart hizmet bedeli sabittir; parça değişimi gerekirse işçilik ve parça fiyatı işlem başlamadan önce yazılı olarak onayınıza sunulur. Onay vermediğiniz hiçbir işlem yapılmaz.'],
]

const checkPoints = [
  'Kombi marka, model ve üretim yılı bilgilerinin kayda alınması',
  'Su basıncı, genleşme tankı ve emniyet ventili kontrolü',
  'Baca gazı, menfez ve hava besleme uygunluğunun ölçülmesi',
  'Tesisat kaçak kontrolü, radyatör ve kolektör dengesi ölçümü',
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      'name': service.title,
      'description': service.summary,
      'serviceType': service.category,
      'provider': {
        '@type': 'HomeAndConstructionBusiness',
        'name': siteSettings.brandName,
        'telephone': siteSettings.phone,
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': siteSettings.location,
          'addressRegion': siteSettings.location,
          'addressCountry': 'TR',
        },
      },
      'areaServed': 'TR',
    },
  ],
}
---

<main>
  <!-- Schema.org JSON-LD (BreadcrumbList + Service) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="detail-hero relative overflow-hidden">
    <div class="detail-hero__image"><SiteImage src="/images/hero-engineering.webp" alt={service.title} fetchpriority="high" /></div>
    <div class="shell detail-hero__content">
      <h2 class="eyebrow"><Clock3 size={14} /> {service.category} · Aynı gün servis</h2>
      <h1>{service.title}</h1>
      <p class="detail-hero__summary">{service.summary}</p>
      <div class="detail-hero__actions">
        <a class="button button--primary" href="#servis-talebi">Servis kaydı oluştur <ArrowRight size={16} /></a>
        <a class="button" style="border-color: var(--navy-soft); color: var(--navy-soft)" href={whatsappHref(`${service.shortTitle} hakkında bilgi almak istiyorum.`)} target="_blank" rel="noreferrer">WhatsApp ile sorun</a>
      </div>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a>
        <ArrowRight size={13} aria-hidden="true" />
        <a href="/hizmetler">Hizmetlerimiz</a>
        <ArrowRight size={13} aria-hidden="true" />
        <span>{service.shortTitle}</span>
      </nav>
    </div>
    <div class="custom-divider-white-left absolute -bottom-[1px] left-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
    <div class="custom-divider-white-right absolute -bottom-[1px] right-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
  </section>

  <section class="detail-layout"><div class="shell detail-layout">
    <article class="detail-main">
      <h3 class="section-kicker">Hizmet kapsamı</h3>
      <h2>{service.shortTitle} işlemini şeffaf yürütüyoruz.</h2>
      <p>{service.summary} Kombici Abi’de her işlem; yerinde inceleme, yazılı fiyat onayı, uygulama ve test adımlarıyla tamamlanır. Gereksiz parça değişimi yapılmaz, size neden-ne için açıklanır.</p>
      <h3>Kontrol noktaları</h3>
      <ul>{checkPoints.map((point) => <li>{point}</li>)}</ul>
      <h3>Servis öncesi hazır bulundurun</h3>
      <p>Kombinizin marka ve modeli, varsa eski servis/fatura kayıtları ve cihazın çalışma ortamına dair fotoğraflar süreci hızlandırır. Daire boşsa veya erişim özel bir izin gerektiriyorsa randevu sırasında belirtmeniz yeterlidir.</p>
      <div class="process-band" style="margin-top: 2.5rem"><h3 class="section-kicker">İzlenecek yol</h3><h2>Beş adımda kontrollü servis.</h2><div class="process-band__grid">{[['01', 'Kayıt', 'Marka, model ve şikâyet kayda alınır.'], ['02', 'Randevu', 'Size uygun saat için söz verilir.'], ['03', 'Tespit', 'Ölçümle kesin neden belirlenir.'], ['04', 'Onay + işlem', 'Net fiyat onaylanır, işlem yapılır.'], ['05', 'Test + garanti', 'Cihaz test edilir, belge teslim edilir.']].map(([number, title, text]) => <div class="process-band__item"><span>{number}</span><h3>{title}</h3><p>{text}</p></div>)}</div></div>
      <h3>Sıkça sorulanlar</h3><div class="faq-list">{serviceFaqs.map(([question, answer]) => <details><summary>{question}<span><CircleCheck size={15} /></span></summary><p>{answer}</p></details>)}</div>
    </article>
    <aside class="detail-side"><div class="side-card"><h3 class="eyebrow"><ShieldCheck size={16} /> Uzman teknik ekip</h3><h2>{service.shortTitle} için aynı gün randevu alın.</h2><p>Cihaz bilgilerinizi paylaşın; uygun zamanı planlayalım, işlem öncesinde net fiyatı yazılı olarak iletelim.</p><a class="button button--primary" href={whatsappHref(`${service.shortTitle} için randevu istiyorum.`)} target="_blank" rel="noreferrer">WhatsApp'tan danışın <ArrowRight size={15} /></a><a class="button" style="width:100%; margin-top:.6rem; border:1px solid var(--line)" href={phoneHref}><Phone size={15} /> {siteSettings.phone}</a><ul class="info-list"><li><BadgeCheck size={15} /> Ölçüm cihazıyla tespit</li><li><FileCheck size={15} /> Faturalı ve belgeli işlem</li><li><ShieldCheck size={15} /> 1 yıl işçilik garantisi</li></ul></div></aside>
  </div></section>

  <section class="form-section" id="servis-talebi"><div class="shell form-section__panel"><SiteImage class="form-section__image" src="/images/project-guidance.webp" alt="Kombi servisi öncesi tesisat kontrolü" /><div class="form-section__wash"></div><ProjectForm services={defaultServices} title={`${service.shortTitle} için teklif alın`} /><div class="form-section__aside"><h3 class="eyebrow">{siteSettings.brandName}</h3><h2>Isınma sorununu ertelemeyin.</h2><p>Cihazınızı ve yaşadığınız sorunu kısaca anlatın; en yakın uygun saat için randevu planlayalım.</p></div></div></section>
  {related.length > 0 && <section class="services-section"><div class="shell"><div class="section-top"><div><h3 class="section-kicker">Aynı alandaki hizmetler</h3><h2 class="section-heading">İlgili servis çözümleri.</h2></div><a href="/hizmetler">Tüm hizmetler <ArrowRight size={16} /></a></div><div class="service-grid">{related.map((item) => <article class="service-card"><a class="service-card__image" href={`/${item.slug}`}><SiteImage src={item.image} alt={item.title} loading="lazy" /></a><div class="service-card__body"><p class="service-card__category">{item.category}</p><h3><a href={`/${item.slug}`}>{item.shortTitle}</a></h3><a class="text-link" href={`/${item.slug}`}>İncele <ArrowRight size={14} /></a></div></article>)}</div></div></section>}
</main>
