---
import SiteImage from './SiteImage.astro'

interface Feature { title: string; description: string }
interface Stat { target: number; suffix?: string; prefix?: string; label: string; description: string }

interface Props {
  heading?: string
  lead?: string
  points?: Feature[]
  stats?: Stat[]
}

const {
  heading = 'Isıtma sisteminizi neden Kombici Abi’ye emanet etmelisiniz?',
  lead = 'Eğitimli teknik kadromuz, ölçüm cihazlarımız ve şeffaf fiyat anlayışımızla her servisi aynı titizlikle tamamlıyoruz.',
  points = [
    { title: 'AYNI GÜN SERVİS AĞI', description: 'Şehir içi mobil ekiplerimiz sayesinde arıza bildiriminin ardından aynı gün kapınızdayız; kışı petek soğuk geçirmek zorunda kalmazsınız.' },
    { title: 'VERİYLE ARIZA TESPİTİ', description: 'Gaz kaçağı, su basıncı ve yanma ölçümlerini cihazla yapıyoruz. “Parça değiştirip görelim” yaklaşımına son; gereksiz masraf çıkmaz.' },
    { title: 'YAZILI NET FİYAT', description: 'İşlem başlamadan önce işçilik ve parça bedeli net olarak paylaşılır. İş bittikten sonra sürpriz ek ücret ile karşılaşmazsınız.' },
    { title: '1 YIL İŞÇİLİK GARANTİSİ', description: 'Yaptığımız bakım ve onarımın arkasında duruyoruz. Aynı arıza tekrarlanırsa ücretsiz tekrar hizmet veriyoruz.' },
  ],
  stats = [
    { target: 12, suffix: '+', label: 'YILLIK SAHA DENEYİMİ', description: 'Kombi ve ısıtma sistemlerinde uzman teknik kadro.' },
    { target: 8500, suffix: '+', label: 'TAMAMLANAN İŞLEM', description: 'Bakım, onarım ve petek temizliği kaydı.' },
    { target: 98, suffix: '%', label: 'İLK ZİYARETTE ÇÖZÜM', description: 'Arızaların büyük kısmı ilk ziyarette giderilir.' },
    { target: 24, suffix: '/7', label: 'WHATSAPP DESTEK', description: 'Randevu ve teknik yönlendirme her an ulaşılabilir.' },
  ],
} = Astro.props

const featuresLeft = points.slice(0, 2)
const featuresRight = points.slice(2, 4)
---

<section class="relative bg-white py-20 lg:py-28 overflow-hidden" id="neden-biz">
  <div class="shell">
    <!-- Header -->
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-block">
        <span class="inline-block -skew-x-12 bg-primary px-5 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-white">
          <span class="inline-block skew-x-12">Neden Bizi Seçmelisiniz?</span>
        </span>
      </div>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-black leading-tight">
        {heading}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed font-normal">
        {lead}
      </p>
    </div>

    <!-- Main 3-Column Interactive Layout -->
    <div class="why-us-grid mt-14 lg:mt-18 grid grid-cols-1 lg:grid-cols-12 items-center gap-8 lg:gap-4">
      <!-- Left Features -->
      <div class="lg:col-span-3 flex flex-col gap-8 order-2 lg:order-1">
        {featuresLeft.map((feat) => (
          <div class="why-feat-left relative border-l-4 border-primary pl-5 py-2 group opacity-0 will-change-transform">
            <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-black group-hover:text-primary transition-colors">
              {feat.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">
              {feat.description}
            </p>
          </div>
        ))}
      </div>

      <!-- Center Visual -->
      <div class="why-car-center lg:col-span-6 flex items-center justify-center order-1 lg:order-2 opacity-0 will-change-transform">
        <div class="relative w-full max-w-[620px] aspect-square flex items-center justify-center">
          <SiteImage
            src="/images/hero-engineering.webp"
            alt="Kombi bakımında ölçüm yapan teknik servis"
            class="w-full h-full object-cover pointer-events-none select-none drop-shadow-xl"
            widths={[420, 620, 820]}
            sizes="(max-width: 1024px) 90vw, 620px"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Features -->
      <div class="lg:col-span-3 flex flex-col gap-8 order-3">
        {featuresRight.map((feat) => (
          <div class="why-feat-right relative border-l-4 lg:border-l-0 lg:border-r-4 border-primary pl-5 lg:pl-0 lg:pr-5 py-2 lg:text-right group opacity-0 will-change-transform">
            <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-black group-hover:text-primary transition-colors">
              {feat.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">
              {feat.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Stats Counters -->
    <div class="why-us-stats mt-16 lg:mt-24 pt-12 border-t border-neutral-200 grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-10">
      {stats.map((stat) => (
        <div class="flex flex-col items-center text-center group">
          <div class="flex items-baseline justify-center text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black group-hover:text-primary transition-colors">
            {stat.prefix && <span class="text-primary mr-0.5">{stat.prefix}</span>}
            <span
              class="countup-num"
              data-target={stat.target}
            >
              0
            </span>
            {stat.suffix && <span class="text-primary ml-0.5">{stat.suffix}</span>}
          </div>
          <div class="mt-2 w-8 h-0.5 bg-primary group-hover:w-14 transition-all duration-300"></div>
          <h4 class="mt-3 text-xs sm:text-sm font-black uppercase tracking-wider text-black">
            {stat.label}
          </h4>
          <p class="mt-1 text-xs text-neutral-600 max-w-[13rem] leading-relaxed">
            {stat.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
